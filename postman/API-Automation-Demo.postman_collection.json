              "var jsonData = pm.response.json();\r",
              "pm.test(\"result is an array\", function () {\r",
              "    pm.expect(jsonData.users).to.be.an(\"array\");\r",
              "});\r",
              "pm.test(\"array is not null\", function () {\r",
              "    pm.expect(jsonData.users.length).to.be.greaterThan(0);\r",
              "});\r",
              "pm.test(\"total is greaterThan 0\", function () {\r",
              "    pm.expect(jsonData.total).to.be.greaterThan(0);\r",
              "});\r",
              "pm.test(\"first record id is not null\", function () {\r",
              "    pm.expect(jsonData.users[0]).to.not.null;\r",
              "});\r",
              "pm.test(\"second record has firstName property\", function () {\r",
              "    pm.expect(jsonData.users[1]).to.have.property(\"firstName\");\r",
              "});\r",
              "pm.test(\"each user id is not null\", function () {\r",
              "    jsonData.users.forEach(function(user){\r",
              "        pm.expect(user).to.not.be.null;\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
