    {
      "name": "Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "pm.test(\"User ID exists\", function () {\r",
              "    pm.expect(jsonData).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "pm.test(\"First name is correct\", function () {\r",
              "    pm.expect(jsonData.firstName).to.eql(\"John\");\r",
              "});\r",
              "pm.test(\"address is exist\", function () {\r",
              "    pm.expect(jsonData.address).to.have.property(\"address\");\r",
              "});\r",
              "pm.test(\"postalCode is correct\", function () {\r",
              "    pm.expect(jsonData.address.postalCode).to.eql(\"k4K 5N6\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"firstName\", \"John\");\r",
              "pm.collectionVariables.set(\"lastName\", \"Test\");\r",
              "pm.collectionVariables.set(\"age\", 30);\r",
              "pm.collectionVariables.set(\"postalCode\", \"k4K 5N6\");"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstName\": \"{{firstName}}\",\r\n    \"lastName\": \"{{lastName}}\",\r\n    \"age\": {{age}},\r\n    \"address\": {\r\n        \"address\": \"5555 Main Street\",\r\n        \"city\": \"Phoenix\",\r\n        \"state\": \"Mississippi\",\r\n        \"stateCode\": \"MS\",\r\n        \"postalCode\": \"{{postalCode}}\"\r\n        }\r\n}",
          "options": {
